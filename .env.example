# Cake environment variables
#
# All variables are required for production except where noted.
# Local dev: copy this file to .env and fill in values.

# Postgres connection string.
#   Dev: a local Postgres (e.g. postgresql://postgres:postgres@localhost:5432/cake)
#   Prod: Neon / Vercel Postgres pooled URL (postgresql://...?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cake"

# Optional: separate Postgres database for unit tests.
# Defaults to DATABASE_URL with the `test` schema when unset.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cake_test"

# NextAuth v5 secret — signs JWT sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the deployed app. Required in production, optional in dev.
# AUTH_URL="https://cake.example.com"

# Required on non-Vercel hosts so auth trusts the host header. Harmless on Vercel.
AUTH_TRUST_HOST=true
